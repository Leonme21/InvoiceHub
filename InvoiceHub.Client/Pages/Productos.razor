@page "/productos"

@using InvoiceHub.Client.Models
@using InvoiceHub.Client.Services
@using InvoiceHub.Client.Shared
@using System.ComponentModel.DataAnnotations
@using System.Net

@inject ProductApiService ProductService

<PageTitle>Productos | InvoiceHub</PageTitle>


<div class="page-header">

    <div>
        <h1>Catálogo de Productos</h1>

        <p class="text-secondary">
            Administra inventario y precios.
        </p>
    </div>


    <button class="btn btn-primary"
            @onclick="OpenCreateModal">

        <svg viewBox="0 0 24 24"
             width="18"
             height="18"
             fill="none"
             stroke="currentColor"
             stroke-width="2">

            <line x1="12"
                  y1="5"
                  x2="12"
                  y2="19">
            </line>

            <line x1="5"
                  y1="12"
                  x2="19"
                  y2="12">
            </line>

        </svg>

        Nuevo Producto

    </button>

</div>


<!-- FILTROS -->

<div class="product-filters">

    <div class="search-input">

        <svg viewBox="0 0 24 24"
             width="18"
             height="18"
             fill="none"
             stroke="currentColor"
             stroke-width="2">

            <circle cx="11"
                    cy="11"
                    r="8">
            </circle>

            <line x1="21"
                  y1="21"
                  x2="16.65"
                  y2="16.65">
            </line>

        </svg>


        <input type="text"
               class="form-control"
               placeholder="Buscar por código o nombre..."
               @bind="SearchTerm"
               @bind:after="PerformSearch" />

    </div>


    <select class="form-control status-filter"
            @onchange="ChangeStatusFilter">

        <option value="active">
            Activos
        </option>

        <option value="inactive">
            Inactivos
        </option>

        <option value="all">
            Todos
        </option>

    </select>

</div>


@if (isLoading)
{
    <LoadingSpinner Text="Cargando catálogo..." />
}
else
{
    <div class="table-container">

        <table class="data-table">

            <thead>

                <tr>

                    <th>Código</th>

                    <th>Nombre</th>

                    <th class="numeric-column">
                        Precio Unit.
                    </th>

                    <th class="numeric-column">
                        Stock
                    </th>

                    <th>
                        Estado
                    </th>

                    <th class="actions-column">
                        Acciones
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var prod in pagedResult.Items)
                {
                    <tr>

                        <!-- Código -->

                        <td>

                            <span class="badge product-code">
                                @prod.Code
                            </span>

                        </td>


                        <!-- Nombre -->

                        <td>
                            @prod.Name
                        </td>


                        <!-- Precio -->

                        <td class="numeric-column product-price">

                            $@prod.UnitPrice.ToString("N2")

                        </td>


                        <!-- Stock -->

                        <td class="numeric-column">

                            <span class="@(prod.Stock < 10
                                                                  ? "text-danger font-bold"
                                                                  : "")">

                        @prod.Stock

                            </span>

                        </td>


                        <!-- Estado -->

                        <td>

                    @if (prod.IsActive)
                            {
                                <span class="badge badge-active">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">
                                    Inactivo
                                </span>
                            }

                        </td>


                        <!-- Acciones -->

                        <td class="actions-column">

                            <div class="actions-cell actions-right">

                                @if (prod.IsActive)
                                {
                                    <!-- EDITAR -->

                                    <button class="btn-icon"
                                            @onclick="() => OpenEditModal(prod.Id)"
                                            title="Editar producto">

                                        <svg viewBox="0 0 24 24"
                                             width="18"
                                             height="18"
                                             fill="none"
                                             stroke="var(--color-primary)"
                                             stroke-width="2">

                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7">
                                            </path>

                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z">
                                            </path>

                                        </svg>

                                    </button>


                                    <!-- DESACTIVAR -->

                                    <button class="btn-icon"
                                            @onclick="() => RequestChangeStatus(prod, false)"
                                            title="Desactivar producto">

                                        <svg viewBox="0 0 24 24"
                                             width="18"
                                             height="18"
                                             fill="none"
                                             stroke="var(--color-danger)"
                                             stroke-width="2">

                                            <circle cx="12"
                                                    cy="12"
                                                    r="9">
                                            </circle>

                                            <line x1="8"
                                                  y1="8"
                                                  x2="16"
                                                  y2="16">
                                            </line>

                                        </svg>

                                    </button>
                                }
                                else
                                {
                                    <!-- REACTIVAR -->

                                    <button class="btn-icon"
                                            @onclick="() => RequestChangeStatus(prod, true)"
                                            title="Reactivar producto">

                                        <svg viewBox="0 0 24 24"
                                             width="18"
                                             height="18"
                                             fill="none"
                                             stroke="var(--color-success)"
                                             stroke-width="2">

                                            <polyline points="23 4 23 10 17 10">
                                            </polyline>

                                            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10">
                                            </path>

                                        </svg>

                                    </button>
                                }

                            </div>

                        </td>

                    </tr>
                }


                @if (!pagedResult.Items.Any())
                {
                    <tr>

                        <td colspan="6"
                            class="empty-state">

                            @GetEmptyMessage()

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- PAGINACIÓN -->

    <div class="pagination-wrapper product-pagination">

        <div class="pagination-left">

            @if (pagedResult.CurrentPage > 1)
            {
                <button class="btn-pagination"
                        @onclick="() => ChangePage(pagedResult.CurrentPage - 1)">

                    <svg viewBox="0 0 24 24"
                         width="18"
                         height="18"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <polyline points="15 18 9 12 15 6">
                        </polyline>

                    </svg>

                    Anterior

                </button>
            }

    </div>


    <div class="pagination-center">

        <span>

            Página

            <strong>
                @(pagedResult.CurrentPage == 0
                                ? 1
                                : pagedResult.CurrentPage)
                                                      </strong>

            de

            <strong>
                @(pagedResult.TotalPages == 0
                                ? 1
                                : pagedResult.TotalPages)
            </strong>

            </span>


            <span class="text-secondary ml-2">

                (Total: @pagedResult.TotalCount registros)

            </span>

        </div>


        <div class="pagination-right">

        @if (pagedResult.CurrentPage < pagedResult.TotalPages)
            {
                <button class="btn-pagination"
                        @onclick="() => ChangePage(pagedResult.CurrentPage + 1)">

                    Siguiente

                    <svg viewBox="0 0 24 24"
                         width="18"
                         height="18"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <polyline points="9 18 15 12 9 6">
                        </polyline>

                    </svg>

                </button>
            }

        </div>

    </div>
}


<!-- MODAL CREAR / EDITAR -->

<Modal @bind-IsVisible="isModalVisible"
       Title="@modalTitle"
       CloseOnBackgroundClick="false">

    <EditForm Model="prodFormModel"
              OnValidSubmit="SaveProduct"
              OnInvalidSubmit="ShowValidationError">

        <DataAnnotationsValidator />


        <!-- Código / Nombre -->

        <div class="grid-2">

            <div class="form-group">

                <label class="form-label">
                    Código (SKU)
                </label>

                <InputText @bind-Value="prodFormModel.Code"
                           class="form-control"
                           disabled="@isEditing"
                           placeholder="Ej. PROD-001" />

                <ValidationMessage For="@(() => prodFormModel.Code)"
                                   class="validation-message" />

            </div>


            <div class="form-group">

                <label class="form-label">
                    Nombre del Producto
                </label>

                <InputText @bind-Value="prodFormModel.Name"
                           class="form-control"
                           placeholder="Ej. Laptop Pro X" />

                <ValidationMessage For="@(() => prodFormModel.Name)"
                                   class="validation-message" />

            </div>

        </div>


        <!-- Descripción -->

        <div class="form-group">

            <label class="form-label">
                Descripción
            </label>

            <InputTextArea @bind-Value="prodFormModel.Description"
                           class="form-control"
                           rows="3"
                           placeholder="Detalles del producto..." />

            <ValidationMessage For="@(() => prodFormModel.Description)"
                               class="validation-message" />

        </div>


        <!-- Precio / Stock -->

        <div class="grid-2">

            <div class="form-group">

                <label class="form-label">
                    Precio Unitario
                </label>

                <InputNumber @bind-Value="prodFormModel.UnitPrice"
                             class="form-control"
                             step="0.01" />

                <ValidationMessage For="@(() => prodFormModel.UnitPrice)"
                                   class="validation-message" />

            </div>


            <div class="form-group">

                <label class="form-label">
                    Stock
                </label>

                <InputNumber @bind-Value="prodFormModel.Stock"
                             class="form-control" />

                <ValidationMessage For="@(() => prodFormModel.Stock)"
                                   class="validation-message" />

            </div>

        </div>


        <!-- Acciones modal -->

        <div class="flex-row justify-end gap-sm mt-4">

            <button type="button"
                    class="btn"
                    @onclick="CloseModal">

                Cancelar

            </button>


            <button type="submit"
                    class="btn btn-primary"
                    disabled="@isSaving">

                @if (isSaving)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }

            </button>

        </div>

    </EditForm>

</Modal>


@code {

    private PagedResult<ProductListResponseDto> pagedResult = new();


    private string SearchTerm { get; set; } = string.Empty;

    private int CurrentPage = 1;

    private int PageSize = 10;

    private bool? ActiveFilter { get; set; } = true;


    private bool isLoading = true;

    private bool isSaving = false;

    private bool isModalVisible = false;

    private bool isEditing = false;


    private string modalTitle = "Nuevo Producto";


    private ProductFormModel prodFormModel = new();

    private int currentEditingId;


    [Inject]
    private SweetAlertService Swal { get; set; } = default!;


    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }


    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            pagedResult = await ProductService.GetPagedAsync(
                SearchTerm,
                CurrentPage,
                PageSize,
                ActiveFilter);
        }
        catch
        {
            await Swal.ShowErrorToastAsync(
                "Error al cargar productos.");
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task ChangeStatusFilter(
        ChangeEventArgs e)
    {
        ActiveFilter = e.Value?.ToString() switch
        {
            "active" => true,
            "inactive" => false,
            "all" => null,
            _ => true
        };

        CurrentPage = 1;

        await LoadData();
    }


    private string GetEmptyMessage()
    {
        if (!string.IsNullOrWhiteSpace(SearchTerm))
        {
            return "No se encontraron productos con los criterios de búsqueda.";
        }

        return ActiveFilter switch
        {
            true => "No hay productos activos registrados.",
            false => "No hay productos inactivos registrados.",
            null => "No hay productos registrados."
        };
    }


    private void OpenCreateModal()
    {
        isEditing = false;

        currentEditingId = 0;

        modalTitle = "Nuevo Producto";

        prodFormModel = new ProductFormModel
        {
            Stock = 0,
            UnitPrice = 0
        };

        isModalVisible = true;
    }


    private async Task OpenEditModal(int id)
    {
        try
        {
            var detail =
                await ProductService.GetByIdAsync(id);

            if (detail is null)
            {
                await Swal.ShowErrorToastAsync(
                    "El producto no existe.");

                return;
            }

            isEditing = true;

            currentEditingId = id;

            modalTitle = "Editar Producto";

            prodFormModel = new ProductFormModel
            {
                Code = detail.Code,
                Name = detail.Name,
                Description = detail.Description,
                UnitPrice = detail.UnitPrice,
                Stock = detail.Stock
            };

            isModalVisible = true;
        }
        catch
        {
            await Swal.ShowErrorToastAsync(
                "Error al cargar los datos del producto.");
        }
    }


    private async Task SaveProduct()
    {
        isSaving = true;

        try
        {
            if (isEditing)
            {
                var dto = new UpdateProductDto
                {
                    Name = prodFormModel.Name,
                    Description = prodFormModel.Description,
                    UnitPrice = prodFormModel.UnitPrice,
                    Stock = prodFormModel.Stock
                };

                await ProductService.UpdateAsync(
                    currentEditingId,
                    dto);

                await Swal.ShowSuccessToastAsync(
                    "Producto actualizado correctamente");
            }
            else
            {
                var dto = new CreateProductDto
                {
                    Code = prodFormModel.Code,
                    Name = prodFormModel.Name,
                    Description = prodFormModel.Description,
                    UnitPrice = prodFormModel.UnitPrice,
                    Stock = prodFormModel.Stock
                };

                await ProductService.CreateAsync(dto);

                await Swal.ShowSuccessToastAsync(
                    "Producto creado correctamente");
            }

            CloseModal();

            await LoadData();
        }
        catch (ApplicationException ex)
        {
            var errorMsg =
                "El código ya existe o los datos son inválidos.";

            if (ex.Message.Contains(
                    "duplicate",
                    StringComparison.OrdinalIgnoreCase)
                ||
                ex.Message.Contains(
                    "IX_Products_Code",
                    StringComparison.OrdinalIgnoreCase)
                ||
                ex.Message.Contains(
                    "código ya se encuentra registrado",
                    StringComparison.OrdinalIgnoreCase))
            {
                errorMsg =
                    "Este código ya está registrado. Puede pertenecer a un producto inactivo.";
            }
            else if (ex.Message.Length < 200)
            {
                errorMsg = ex.Message;
            }

            await Swal.ShowErrorToastAsync(errorMsg);
        }
        catch
        {
            await Swal.ShowErrorToastAsync(
                "Ocurrió un error al guardar en el servidor.");
        }
        finally
        {
            isSaving = false;
        }
    }


    private async Task RequestChangeStatus(
        ProductListResponseDto product,
        bool newStatus)
    {
        var safeName =
            WebUtility.HtmlEncode(product.Name);

        string title;

        string message;

        string buttonText;


        if (newStatus)
        {
            title =
                "¿Reactivar producto?";

            message =
                $"¿Deseas reactivar <b>{safeName}</b>? " +
                "Volverá a estar disponible para nuevas ventas.";

            buttonText =
                "Sí, reactivar";
        }
        else
        {
            title =
                "¿Desactivar producto?";

            message =
                $"¿Deseas desactivar <b>{safeName}</b>? " +
                "No podrá utilizarse en nuevas ventas, " +
                "pero permanecerá disponible en el historial.";

            buttonText =
                "Sí, desactivar";
        }


        var confirmed =
            await Swal.ConfirmAsync(
                title,
                message,
                buttonText);


        if (!confirmed)
        {
            return;
        }


        await ChangeProductStatus(
            product.Id,
            newStatus);
    }


    private async Task ChangeProductStatus(
        int productId,
        bool isActive)
    {
        try
        {
            await ProductService.ChangeStatusAsync(
                productId,
                isActive);

            await Swal.ShowSuccessToastAsync(
                isActive
                    ? "Producto reactivado correctamente"
                    : "Producto desactivado correctamente");

            await LoadData();
        }
        catch (ApplicationException ex)
        {
            await Swal.ShowErrorToastAsync(
                ex.Message);
        }
        catch
        {
            await Swal.ShowErrorToastAsync(
                "Error al actualizar el estado del producto.");
        }
    }


    private async Task ShowValidationError(
        EditContext context)
    {
        var errors =
            context.GetValidationMessages();

        if (errors.Any())
        {
            await Swal.ShowErrorToastAsync(
                errors.First());
        }
        else
        {
            await Swal.ShowErrorToastAsync(
                "Por favor, corrige los errores del formulario.");
        }
    }


    private async Task PerformSearch()
    {
        CurrentPage = 1;

        await LoadData();
    }


    private async Task ChangePage(int newPage)
    {
        CurrentPage = newPage;

        await LoadData();
    }


    private void CloseModal()
    {
        isModalVisible = false;

        isEditing = false;

        currentEditingId = 0;
    }


    public class ProductFormModel
    {
        [Required(
            ErrorMessage = "El código del producto es obligatorio.")]

        [MaxLength(
            50,
            ErrorMessage = "El código no puede exceder los 50 caracteres.")]

        public string Code { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage = "El nombre del producto es obligatorio.")]

        [MaxLength(
            150,
            ErrorMessage = "El nombre no puede exceder los 150 caracteres.")]

        public string Name { get; set; } =
            string.Empty;


        [MaxLength(
            500,
            ErrorMessage = "La descripción es demasiado larga (máximo 500 caracteres).")]

        public string Description { get; set; } =
            string.Empty;


        [Range(
            0.01,
            double.MaxValue,
            ErrorMessage = "El precio unitario debe ser mayor a cero.")]

        public decimal UnitPrice { get; set; }


        [Range(
            0,
            int.MaxValue,
            ErrorMessage = "El stock no puede ser negativo.")]

        public int Stock { get; set; }
    }
}