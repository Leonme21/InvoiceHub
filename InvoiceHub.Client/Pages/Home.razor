@page "/"
@using InvoiceHub.Client.Models
@using InvoiceHub.Client.Services
@using InvoiceHub.Client.Shared
@inject ClientApiService ClientService
@inject ProductApiService ProductService
@inject InvoiceApiService InvoiceService
@inject IJSRuntime JS

<PageTitle>InvoiceHub - Dashboard</PageTitle>

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p class="text-secondary">Resumen de tu negocio al instante.</p>
    </div>
</div>

@if (isLoading)
{
    <LoadingSpinner Text="Cargando estadísticas..." />
}
else
{
    <div class="stats-grid mb-4">
        <div class="stat-card glass-panel">
            <div class="stat-icon clients">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                </svg>
            </div>
            <div class="stat-details">
                <h3>@totalClients</h3>
                <span class="text-secondary">Clientes Totales</span>
            </div>
        </div>

        <div class="stat-card glass-panel">
            <div class="stat-icon products">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
            </div>
            <div class="stat-details">
                <h3>@totalProducts</h3>
                <span class="text-secondary">Productos en Catálogo</span>
            </div>
        </div>

        <div class="stat-card glass-panel">
            <div class="stat-icon invoices">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </div>
            <div class="stat-details">
                <h3>@totalInvoices</h3>
                <span class="text-secondary">Facturas Emitidas</span>
            </div>
        </div>
    </div>

    <div class="table-container">
        <div class="table-header p-4 border-b" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <h3>Historial de Facturas</h3>
            
            <div class="search-box">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="search-icon">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" class="form-control" placeholder="Buscar por número o cliente... (Presiona Enter)" @bind="searchTerm" @bind:event="oninput" @onkeyup="PerformSearch" />
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nº Factura</th>
                    <th>Cliente</th>
                    <th class="text-right">Total</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in recentInvoices)
                {
                    <tr class="@(viewedInvoice?.Id == invoice.Id ? "expanded-parent-row" : "")">
                        <td><span class="badge badge-active">@invoice.InvoiceNumber</span></td>
                        <td>@invoice.ClientName</td>
                        <td class="text-right font-bold">$@invoice.Total.ToString("N2")</td>
                        <td class="text-center">
                            <div class="actions-cell">
                                <button class="btn-icon" title="@(viewedInvoice?.Id == invoice.Id ? "Cerrar Factura" : "Ver Factura")" @onclick="() => ViewInvoice(invoice.Id)">
                                    @if (viewedInvoice?.Id == invoice.Id)
                                    {
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    }
                                </button>
                            </div>
                        </td>
                    </tr>
                    @if (viewedInvoice?.Id == invoice.Id)
                    {
                        <tr class="expanded-row-content">
                            <td colspan="4" style="padding: 0;">
                                <div class="inline-receipt-container" style="background-color: var(--bg-surface); padding: 2rem; border-bottom: 1px solid var(--border-subtle); overflow: visible;">
                                    <div class="receipt-modal-content" style="max-width: 600px; margin: 0 auto; position: relative; overflow: visible; height: auto;">
                                        <div class="receipt-header">
                                            <h2>Detalle de Factura</h2>
                                        </div>
                                        
                                        <div class="receipt-body" style="overflow: visible;">
                                            <div class="receipt-info">
                                                <p><strong>Factura N°:</strong> <span>@viewedInvoice.InvoiceNumber</span></p>
                                                <p><strong>Cliente:</strong> <span>@viewedInvoice.ClientName</span></p>
                                                <p><strong>Fecha:</strong> <span>@GetInvoiceDate(viewedInvoice.InvoiceNumber)</span></p>
                                            </div>

                                            <table class="receipt-table" style="overflow: visible;">
                                                <thead>
                                                    <tr>
                                                        <th>Cant</th>
                                                        <th>Descripción</th>
                                                        <th class="text-right">Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in viewedInvoice.Details)
                                                    {
                                                        <tr>
                                                            <td>@item.Quantity</td>
                                                            <td>@item.ProductName</td>
                                                            <td class="text-right">$@item.LineTotal.ToString("N2")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>

                                            <div class="receipt-totals">
                                                <p><span>Subtotal:</span> <span>$@viewedInvoice.SubTotal.ToString("N2")</span></p>
                                                <p><span>IVA (19%):</span> <span>$@viewedInvoice.TaxAmount.ToString("N2")</span></p>
                                                <p class="grand-total"><span>TOTAL:</span> <span>$@viewedInvoice.Total.ToString("N2")</span></p>
                                            </div>
                                        </div>

                                        <div class="receipt-footer-actions">
                                            <button class="btn btn-print" @onclick="PrintReceipt" style="width: 100%;">
                                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                                                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                                    <rect x="6" y="14" width="12" height="8"></rect>
                                                </svg>
                                                Imprimir Factura
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (!recentInvoices.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No hay facturas emitidas todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pagination-wrapper">
            <div class="pagination-left">
                @if (currentPage > 1)
                {
                    <button class="btn-pagination" @onclick="() => ChangePage(currentPage - 1)">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        Anterior
                    </button>
                }
            </div>
            
            <div class="pagination-center">
                <span>Página <strong>@(currentPage == 0 ? 1 : currentPage)</strong> de <strong>@(totalPages == 0 ? 1 : totalPages)</strong></span>
                <span class="text-secondary ml-2">(Total: @totalCount registros)</span>
            </div>

            <div class="pagination-right">
                @if (currentPage < totalPages)
                {
                    <button class="btn-pagination" @onclick="() => ChangePage(currentPage + 1)">
                        Siguiente
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                }
            </div>
        </div>
    </div>
}



<style>
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: var(--spacing-md);
    }

    .stat-card {
        padding: var(--spacing-lg);
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
    }

    .stat-icon.clients { background: hsla(250, 80%, 60%, 0.15); color: hsl(250, 80%, 60%); }
    .stat-icon.products { background: hsla(190, 80%, 50%, 0.15); color: hsl(190, 80%, 50%); }
    .stat-icon.invoices { background: hsla(150, 70%, 45%, 0.15); color: hsl(150, 70%, 45%); }

    .stat-details h3 {
        margin: 0;
        font-size: 2rem;
        line-height: 1.1;
    }

    .p-4 { padding: var(--spacing-md); }
    .border-b { border-bottom: var(--border-subtle); }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .font-bold { font-weight: 700; color: var(--color-primary); }
    .py-4 { padding-top: var(--spacing-lg); padding-bottom: var(--spacing-lg); }
    
    .search-box {
        position: relative;
        width: 100%;
        max-width: 500px;
        min-width: 0;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary);
    }

    .search-box input {
        padding-left: 40px;
    }
</style>

@code {
    private bool isLoading = true;
    private int totalClients = 0;
    private int totalProducts = 0;
    private int totalInvoices = 0;
    
    private List<InvoiceListResponseDto> recentInvoices = new();

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages = 1;
    private string searchTerm = string.Empty;

    private InvoiceResponseDto? viewedInvoice = null;

    [Inject] private SweetAlertService Swal { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clients = await ClientService.GetAllAsync();
            var products = await ProductService.GetAllAsync();

            totalClients = clients.Count;
            totalProducts = products.Count;
            
            await LoadInvoices();
        }
        catch
        {
            totalClients = 0;
            totalProducts = 0;
            totalInvoices = 0;
            recentInvoices = new List<InvoiceListResponseDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadInvoices()
    {
        var pagedInvoices = await InvoiceService.GetPagedAsync(searchTerm, currentPage, pageSize);
        recentInvoices = pagedInvoices.Items;
        totalCount = pagedInvoices.TotalCount;
        totalPages = pagedInvoices.TotalPages;

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            totalInvoices = totalCount;
        }
    }

    private async Task PerformSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadInvoices();
        }
    }

    private async Task ChangePage(int newPage)
    {
        currentPage = newPage;
        await LoadInvoices();
    }

    private async Task ViewInvoice(int id)
    {
        if (viewedInvoice?.Id == id)
        {
            viewedInvoice = null;
            return;
        }

        try
        {
            var detail = await InvoiceService.GetByIdAsync(id);
            if (detail != null)
            {
                viewedInvoice = detail;
            }
        }
        catch
        {
            await Swal.ShowErrorToastAsync("Error al cargar los detalles de la factura");
        }
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private string GetInvoiceDate(string invoiceNumber)
    {
        if (!string.IsNullOrEmpty(invoiceNumber) && invoiceNumber.StartsWith("INV-") && invoiceNumber.Length == 18)
        {
            if (DateTime.TryParseExact(invoiceNumber.Substring(4), "yyyyMMddHHmmss", null, System.Globalization.DateTimeStyles.None, out var date))
            {
                return date.ToString("dd/MM/yyyy HH:mm");
            }
        }
        return string.Empty;
    }
}
