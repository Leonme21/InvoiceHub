@page "/facturacion"
@using InvoiceHub.Client.Models
@using InvoiceHub.Client.Services
@using InvoiceHub.Client.Shared
@inject ClientApiService ClientService
@inject ProductApiService ProductService
@inject InvoiceApiService InvoiceService
@inject IJSRuntime JS

<PageTitle>Punto de Venta | InvoiceHub</PageTitle>

<div class="page-header">
    <div>
        <h1>Punto de Venta (POS)</h1>
        <p class="text-secondary">Generación rápida de facturas.</p>
    </div>
</div>

@if (isLoading)
{
    <LoadingSpinner Text="Cargando recursos del POS..." />
}
else
{
    <div class="pos-layout">
        <div class="pos-main flex-col gap-md">
            
            <div class="glass-panel p-4">
                <h3 class="mb-4">1. Selección de Cliente</h3>
                <div class="form-group mb-0 w-100">
                    <select class="form-control w-100" @bind="selectedClientId">
                        <option value="0">-- Seleccione un cliente --</option>
                        @foreach (var client in clients.Where(c => c.IsActive))
                        {
                            <option value="@client.Id">@client.Document - @client.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="glass-panel p-4">
                <h3 class="mb-4">2. Agregar Productos</h3>
                <div class="add-product-row w-100">
                    <div class="form-group flex-1 w-100">
                        <select class="form-control w-100" @bind="selectedProductId">
                            <option value="0">-- Buscar producto --</option>
                            @foreach (var prod in products.Where(p => p.Stock > 0))
                            {
                                <option value="@prod.Id">[@prod.Code] @prod.Name (Stock: @prod.Stock | $@prod.UnitPrice.ToString("N2"))</option>
                            }
                        </select>
                    </div>
                    <div class="form-group quantity-box w-100">
                        <input type="number" class="form-control text-center w-100" min="1" @bind="quantityToAdd" />
                    </div>
                    <div class="form-group w-100">
                        <button class="btn btn-primary w-100" @onclick="AddToCart">
                            Agregar
                        </button>
                    </div>
                </div>

                <div class="table-container mt-4">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Producto</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-right">Precio</th>
                                <th class="text-right">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cart)
                            {
                                <tr>
                                    <td><span class="badge badge-inactive">@item.ProductCode</span></td>
                                    <td>@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-right">$@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-right font-bold">$@item.LineTotal.ToString("N2")</td>
                                    <td class="text-right">
                                        <button class="btn-icon" @onclick="() => RemoveFromCart(item.ProductId)">
                                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-danger)" stroke-width="2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!cart.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">El carrito está vacío.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="glass-panel p-4">
                <h3 class="mb-4">Observaciones</h3>
                <textarea class="form-control" rows="2" @bind="observations" maxlength="500" placeholder="Notas adicionales para la factura (opcional, máx. 500 caracteres)"></textarea>
                @if (!string.IsNullOrEmpty(observations))
                {
                    <small class="text-secondary" style="margin-top: 4px; display: block;">@observations.Length / 500 caracteres</small>
                }
            </div>
        </div>

        <!-- Right Panel: Summary & Checkout -->
        <div class="pos-sidebar">
            <div class="glass-panel summary-card">
                <div class="summary-header">
                    <h3>Resumen de Venta</h3>
                </div>
                
                <div class="summary-body">
                    <div class="summary-row">
                        <span class="text-secondary">Subtotal</span>
                        <span>$@SubTotal.ToString("N2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="text-secondary">IVA (19%)</span>
                        <span>$@TaxAmount.ToString("N2")</span>
                    </div>
                    <hr class="summary-divider" />
                    <div class="summary-row total-row">
                        <span>TOTAL</span>
                        <span class="total-amount">$@Total.ToString("N2")</span>
                    </div>
                </div>
                
                <div class="summary-footer">
                    <button class="btn btn-primary checkout-btn" @onclick="GenerateInvoice" disabled="@isGenerating">
                        @if (isGenerating)
                        {
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                            <span>Generar Factura</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (showReceiptModal && generatedInvoice != null)
{
    <div class="modal-backdrop show-modal">
        <div class="receipt-modal-content">
            <div class="receipt-header">
                <h2>Factura Generada</h2>
            </div>
            
            <div class="receipt-body">
                <div class="receipt-info">
                    <p><strong>Factura N°:</strong> <span>@generatedInvoice.InvoiceNumber</span></p>
                    <p><strong>Cliente:</strong> <span>@generatedInvoice.ClientName</span></p>
                    <p><strong>Fecha:</strong> <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span></p>
                </div>

                <table class="receipt-table">
                    <thead>
                        <tr>
                            <th>Cant</th>
                            <th>Descripción</th>
                            <th class="text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in generatedInvoice.Details)
                        {
                            <tr>
                                <td>@item.Quantity</td>
                                <td>@item.ProductName</td>
                                <td class="text-right">$@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="receipt-totals">
                    <p><span>Subtotal:</span> <span>$@generatedInvoice.SubTotal.ToString("N2")</span></p>
                    <p><span>IVA (19%):</span> <span>$@generatedInvoice.TaxAmount.ToString("N2")</span></p>
                    <p class="grand-total"><span>TOTAL:</span> <span>$@generatedInvoice.Total.ToString("N2")</span></p>
                </div>
            </div>

            <div class="receipt-footer-actions">
                <button class="btn btn-new-invoice" @onclick="CloseReceiptModal">Nueva Factura</button>
                <button class="btn btn-print" @onclick="PrintReceipt">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                    Imprimir
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isGenerating = false;
    private bool showReceiptModal = false;
    
    private InvoiceResponseDto? generatedInvoice = null;
    
    private List<ClientListResponseDto> clients = new();
    private List<ProductListResponseDto> products = new();
    private List<CartItem> cart = new();

    private int selectedClientId = 0;
    private int selectedProductId = 0;
    private int quantityToAdd = 1;
    private string observations = string.Empty;

    [Inject] private SweetAlertService Swal { get; set; } = default!;

    private decimal SubTotal => cart.Sum(c => c.LineTotal);
    private decimal TaxAmount => SubTotal * 0.19m; 
    private decimal Total => SubTotal + TaxAmount;
    
    private bool CanCheckout => selectedClientId > 0 && cart.Any();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clients = await ClientService.GetAllAsync();
            products = await ProductService.GetAllAsync();
        }
        catch
        {
            await Swal.ShowErrorToastAsync("Error al inicializar POS");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddToCart()
    {
        if (selectedProductId == 0)
        {
            await Swal.ShowErrorToastAsync("Debe seleccionar un producto de la lista.");
            return;
        }

        if (quantityToAdd < 1)
        {
            await Swal.ShowErrorToastAsync("La cantidad a agregar debe ser al menos 1.");
            return;
        }

        var product = products.FirstOrDefault(p => p.Id == selectedProductId);
        if (product == null)
        {
            await Swal.ShowErrorToastAsync("El producto seleccionado no existe o no está disponible.");
            return;
        }

        var existingItem = cart.FirstOrDefault(c => c.ProductId == selectedProductId);
        
        int currentQtyInCart = existingItem?.Quantity ?? 0;
        if (currentQtyInCart + quantityToAdd > product.Stock)
        {
            await Swal.ShowErrorToastAsync($"Stock insuficiente. Stock actual: {product.Stock}");
            return;
        }

        if (existingItem != null)
        {
            existingItem.Quantity += quantityToAdd;
        }
        else
        {
            cart.Add(new CartItem
            {
                ProductId = product.Id,
                ProductCode = product.Code,
                ProductName = product.Name,
                UnitPrice = product.UnitPrice,
                Quantity = quantityToAdd,
                AvailableStock = product.Stock
            });
        }

        // Reset inputs
        selectedProductId = 0;
        quantityToAdd = 1;
        await Swal.ShowSuccessToastAsync("Producto agregado al carrito");
    }

    private void RemoveFromCart(int productId)
    {
        var item = cart.FirstOrDefault(c => c.ProductId == productId);
        if (item != null)
        {
            cart.Remove(item);
        }
    }

    private async Task GenerateInvoice()
    {
        if (selectedClientId == 0)
        {
            await Swal.ShowErrorToastAsync("Debe seleccionar un cliente antes de facturar.");
            return;
        }

        if (!cart.Any())
        {
            await Swal.ShowErrorToastAsync("Debe agregar al menos un producto al carrito.");
            return;
        }

        if (!string.IsNullOrEmpty(observations) && observations.Length > 500)
        {
            await Swal.ShowErrorToastAsync("Las observaciones no pueden exceder los 500 caracteres.");
            return;
        }

        isGenerating = true;
        try
        {
            var request = new InvoiceRequestDto
            {
                ClientId = selectedClientId,
                Observations = observations,
                Details = cart.Select(c => new InvoiceDetailRequestDto
                {
                    ProductId = c.ProductId,
                    Quantity = c.Quantity
                }).ToList()
            };

            var result = await InvoiceService.CreateAsync(request);
            
            products = await ProductService.GetAllAsync();
            
            generatedInvoice = result;
            showReceiptModal = true;
        }
        catch (ApplicationException ex)
        {
            string errorMsg = "Error al generar la factura.";
            if (ex.Message.Contains("stock", StringComparison.OrdinalIgnoreCase))
            {
                errorMsg = "Stock insuficiente para uno o más productos. Verifique las cantidades.";
            }
            else if (ex.Message.Length < 200)
            {
                errorMsg = ex.Message;
            }
            await Swal.ShowErrorToastAsync(errorMsg);
        }
        catch
        {
            await Swal.ShowErrorToastAsync("Error inesperado al generar la factura");
        }
        finally
        {
            isGenerating = false;
        }
    }

    private void CloseReceiptModal()
    {
        showReceiptModal = false;
        generatedInvoice = null;

        cart.Clear();
        selectedClientId = 0;
        observations = string.Empty;
    }

    private async Task PrintReceipt()
    {
        await JS.InvokeVoidAsync("window.print");
    }
}
